# Кватэрка.by — example configuration
#
# Copy to .env.local and adjust. Placeholders only: never commit a real
# connection string, bucket URL or credential to this repository.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------
# `pglite` runs an in-process PostgreSQL with no server to install, seeds
# demo data on first boot, and persists to .pgdata/. It is a development
# convenience: the runtime REFUSES it when NODE_ENV=production.
DATABASE_URL=pglite

# Production wants a real PostgreSQL 16+:
# DATABASE_URL=postgres://user:password@host:5432/kvaterka

# Optional. Integration tests run against pglite unless this is set, in
# which case they run against a real server — which is the only way to
# verify concurrency behaviour properly.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/kvaterka_test

NODE_ENV=development

# ---------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------
# Listing photos. UNSET in development: uploads are written to .media/ and
# served through /media/*, and /api/uploads returns 501 rather than
# claiming a success it cannot deliver once this IS set but unimplemented.
# MEDIA_BUCKET_URL=https://media.example.com

# Where development uploads land. Defaults to ./.media
# DEV_MEDIA_DIR=./.media

# Identity documents. MUST be a different bucket from MEDIA_BUCKET_URL —
# the runtime refuses to start if they match, because a public media route
# must never be able to reach a passport scan.
# DOCUMENTS_BUCKET_URL=https://private-documents.example.com

# ---------------------------------------------------------------------
# Map tiles
# ---------------------------------------------------------------------
# No provider is chosen yet; this interacts with LEGAL-014 in
# LEGAL_RISK_REGISTER.md. While unset, the map renders markers in their
# true relative positions and says plainly that no tile layer is
# connected, rather than faking cartography.
# NEXT_PUBLIC_MAP_STYLE_URL=

# ---------------------------------------------------------------------
# Migrations
# ---------------------------------------------------------------------
# Only needed if the SQL files are not at ./db/migrations
# MIGRATIONS_DIR=./db/migrations
