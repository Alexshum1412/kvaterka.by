# Кватэрка.by — example configuration
#
# Copy to .env.local and adjust. Placeholders only: never commit a real
# connection string, bucket URL or credential to this repository.
#
#   cp .env.example .env.local
#
# ======================================================================
# THE WHOLE LIST, AT A GLANCE
#
# Every variable the code reads. "Secret" means it must never appear in
# this repository, in a report, in a screenshot or in a chat message.
#
#   NAME                      REQUIRED      SECRET  WHERE IT IS SET
#   ------------------------  ------------  ------  --------------------------
#   DATABASE_URL              yes           YES     host env / .env.local
#   NODE_ENV                  production    no      process manager
#   PUBLIC_BASE_URL           production    no      host env
#   JOB_RUNNER_TOKEN          production    YES     host env + scheduler
#   BASE_URL                  scheduler     no      cron line / timer unit
#   SITE_INDEXABLE            no  (false)   no      host env — see below
#   DATABASE_POOL_MAX         no  (10)      no      host env
#   DATABASE_SSL              no  (false)   no      host env
#   JOB_TIMEOUT_MS            no  (120000)  no      cron line
#   SMTP_URL                  no            YES     host env — not yet wired
#   TELEGRAM_BOT_TOKEN        no            YES     host env — not yet wired
#   MEDIA_BUCKET_URL          no            maybe   host env — not yet wired
#   DOCUMENTS_BUCKET_URL      no            maybe   host env — not yet wired
#   NEXT_PUBLIC_MAP_STYLE_URL no            no      build env — SHIPS TO BROWSER
#   DEV_MEDIA_DIR             no  (./.media) no     development only
#   TEST_DATABASE_URL         no            YES     CI / developer machine
#   MIGRATIONS_DIR            no            no      rarely
#
# Nothing here fails silently. Every value above is validated at startup by
# src/server/runtime.ts, and a bad one stops the process instead of surfacing
# three hours later as an odd error in a log nobody is reading.
# ======================================================================

# ---------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------
# `pglite` runs an in-process PostgreSQL with no server to install, seeds
# demo data on first boot, and persists to .pgdata/. It is a development
# convenience: the runtime REFUSES it when NODE_ENV=production.
DATABASE_URL=pglite

# Production. The schema needs no extensions and runs unchanged on
# PostgreSQL 10, 16 and 18 — the production host offers 10.23, which is
# what CI tests against.
# DATABASE_URL=postgres://user:password@host:5432/kvaterka
#
# TWO THINGS THE DATABASE ITSELF MUST BE, or migration 0001 refuses to run:
#
#   ENCODING  UTF8
#   LC_CTYPE  a UTF-8 locale — ru_RU.UTF-8, be_BY.UTF-8, en_US.UTF-8 and
#             C.UTF-8 all work. Plain C and POSIX DO NOT.
#
# Under LC_CTYPE=C, lower('МИНСК') returns 'МИНСК' unchanged. Nothing errors:
# every query succeeds, every English test passes, and Russian search quietly
# returns nothing for anyone who does not capitalise their city. If you create
# the database by hand:
#
#   CREATE DATABASE kvaterka ENCODING 'UTF8'
#     LC_COLLATE 'ru_RU.UTF-8' LC_CTYPE 'ru_RU.UTF-8' TEMPLATE template0;
#
# The role does NOT need to be a superuser, and should not be one.

# Optional. Integration tests run against pglite unless this is set, in
# which case they run against a real server — which is the only way to
# verify concurrency behaviour, and the only way to verify that the schema
# applies to the PostgreSQL version production actually runs.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/kvaterka_test

NODE_ENV=development

# Connection pool size and TLS. Defaults: 10 and false.
#
# POOL SIZE MATTERS ON SHARED HOSTING. A shared PostgreSQL commonly caps an
# account at 20-40 connections in total, and this pool is per Node process.
# Ten is comfortable for one process; if the host runs several, divide.
# Exceeding the cap does not degrade — new connections are refused and
# requests fail.
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true

# ---------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------
# Used to build links inside notifications. Wrong value = every link in
# every email points at localhost. Defaults to http://localhost:3000
# PUBLIC_BASE_URL=https://kvaterka.by

# ---------------------------------------------------------------------
# Search engine indexing
# ---------------------------------------------------------------------
# Defaults to FALSE, and must stay false for every staging deployment.
# src/app/robots.ts then serves a disallow-all robots.txt.
#
# The first deployment lands on the real domain while the product is still
# closed. A crawler that finds it puts demonstration flats and seeded people
# into search results, and getting them out again is somebody's week. Opening
# this is a deliberate act performed once, at launch — and robots.txt is a
# request, not a lock, so the staging deployment is also behind HTTP basic
# auth in deploy/nginx.conf.
# SITE_INDEXABLE=true

# ---------------------------------------------------------------------
# Scheduled jobs (required in production)
# ---------------------------------------------------------------------
# The credential a scheduler presents to run the three background jobs:
# the notification drain, the lifecycle sweep and the retention purge.
#
# It is NOT an admin account. It authorises exactly three job routes and
# can read nothing at all, so a leak lets an attacker run a job early --
# which the job_run mutex already makes close to harmless -- rather than
# handing over the verification console. See src/server/api/machine.ts.
#
# UNSET means no scheduler can run anything: the queue stops draining,
# stale requests stop expiring, completion windows stop opening. It fails
# closed rather than open, but it does fail. Set it in production.
#
#   openssl rand -base64 48
#
# Minimum 32 characters; a shorter value stops the process at startup.
# JOB_RUNNER_TOKEN=

# THE SCHEDULER READS A DIFFERENT VARIABLE FROM THE APPLICATION.
#
# scripts/run-jobs.mjs calls the job routes over HTTP and reads BASE_URL,
# not PUBLIC_BASE_URL. They are separate on purpose: the application needs
# the address a tenant clicks, while the scheduler wants the shortest path
# to the process — normally loopback, which keeps working when DNS or the
# certificate is having a bad day.
#
# Setting only PUBLIC_BASE_URL leaves the scheduler talking to
# http://localhost:3000, which is right on a VPS and wrong on shared
# hosting, where the app is not on port 3000.
#
# BASE_URL=http://127.0.0.1:3000
# JOB_TIMEOUT_MS=120000
#
# The cron line MUST carry both BASE_URL and JOB_RUNNER_TOKEN. cron gets
# almost no environment, so a line that works in your shell can still do
# nothing at all under cron — run-jobs.mjs exits 2 and says which one is
# missing rather than reporting an empty queue.
#
#   */15 * * * * cd /home/USER/kvaterka && BASE_URL=http://127.0.0.1:3000 \
#     JOB_RUNNER_TOKEN=... /usr/bin/node scripts/run-jobs.mjs >> jobs.log 2>&1

# ---------------------------------------------------------------------
# Notification delivery
# ---------------------------------------------------------------------
# UNSET in development, and both channels then refuse to send rather than
# reporting a success they cannot deliver. Only IN_APP reaches anybody
# until these are configured AND a client is implemented for them --
# setting the variable alone is not enough today, and the provider says so
# in the job report rather than pretending. See docs/EMAIL_PRODUCTION.md.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------
# Listing photos. UNSET in development: uploads are written to .media/ and
# served through /media/*, and /api/uploads returns 501 rather than
# claiming a success it cannot deliver once this IS set but unimplemented.
#
# ON A HOST WITH EPHEMERAL DISK, .media/ IS LOST ON EVERY RESTART. That is
# not a warning about performance; it is every photograph every landlord
# uploaded, gone, with the database still holding rows that point at them.
# MEDIA_BUCKET_URL=https://media.example.com

# Where development uploads land. Defaults to ./.media
# DEV_MEDIA_DIR=./.media

# Identity documents. MUST be a different bucket from MEDIA_BUCKET_URL —
# the runtime refuses to start if they match, because a public media route
# must never be able to reach a passport scan.
# DOCUMENTS_BUCKET_URL=https://private-documents.example.com

# ---------------------------------------------------------------------
# Map tiles
# ---------------------------------------------------------------------
# NEXT_PUBLIC_ MEANS THIS VALUE IS COMPILED INTO THE BROWSER BUNDLE. Never
# put a key here that is not meant to be read by anyone who opens the page.
#
# No provider is chosen yet; this interacts with LEGAL-014 in
# LEGAL_RISK_REGISTER.md. While unset, the map renders markers in their
# true relative positions and says plainly that no tile layer is
# connected, rather than faking cartography.
# NEXT_PUBLIC_MAP_STYLE_URL=

# ---------------------------------------------------------------------
# Migrations
# ---------------------------------------------------------------------
# Only needed if the SQL files are not at ./db/migrations
# MIGRATIONS_DIR=./db/migrations
